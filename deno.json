{
  "name": "@worlds/indexeddb",
  "description": "IndexedDB durable backend for the Worlds client — RDF/JS quad primitive packaged with the worlds impl.",
  "version": "0.1.0",
  "license": "WTFPL",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "minimumDependencyAge": 0,
  "exports": {
    ".": "./src/mod.ts",
    "./rdfjs-store": "./src/indexeddb/rdfjs-store/mod.ts",
    "./search-index": "./src/indexeddb/search-index/mod.ts",
    "./sdk": "./src/indexeddb/sdk/mod.ts"
  },
  "imports": {
    "@/": "./src/",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@tensorflow/tfjs": "npm:@tensorflow/tfjs@^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "npm:@tensorflow/tfjs-backend-wasm@^4.22.0",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@^0.4.0",
    "@wazoo/sparql-engine/term": "jsr:@wazoo/sparql-engine@^0.4.0/term",
    "@worlds/sdk": "jsr:@worlds/sdk@^0.4.0",
    "@worlds/sdk/rdfjs": "jsr:@worlds/sdk@^0.4.0/rdfjs",
    "@worlds/sdk/testing": "jsr:@worlds/sdk@^0.4.0/testing",
    "@worlds/sdk/memory": "jsr:@worlds/sdk@^0.4.0/memory",
    "@worlds/sdk/search-index": "jsr:@worlds/sdk@^0.4.0/search-index",
    "@worlds/sdk/search-index/quad-chunker": "jsr:@worlds/sdk@^0.4.0/search-index/quad-chunker",
    "@worlds/sdk/search-index/embedding-service": "jsr:@worlds/sdk@^0.4.0/search-index/embedding-service",
    "fake-indexeddb": "npm:fake-indexeddb@^6.0.0",
    "fake-indexeddb/auto": "npm:fake-indexeddb@^6.0.0/auto",
    "@langchain/textsplitters": "npm:@langchain/textsplitters@^1.0.1"
  },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "test/"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check",
    "test": "deno test --allow-all",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": [
        "fmt:check",
        "lint",
        "check",
        "test"
      ]
    }
  }
}
